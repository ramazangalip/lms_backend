# Python 3.12 slim imajını kullan (senin sürümünle tam uyumlu)
FROM python:3.12-slim

# Sistem paketlerini kur (PostgreSQL bağlantısı için libpq-dev şart)
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1. Pip install (Docker imajı oluşturulurken yapılır)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Proje dosyalarını kopyala
COPY . .

# 2. Collectstatic (Dosyalar Docker imajına gömülür)
RUN python manage.py collectstatic --noinput

# 3. Senin istediğin başlatma komutu (Migrate + Gunicorn)
# Hugging Face 7860 portunda çalışır
CMD python manage.py migrate && gunicorn --bind 0.0.0.0:7860 lms.wsgi:application